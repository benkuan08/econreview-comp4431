# Copy to .env in the project root. No cloud or model calls happen on startup.
BACKEND_DATABASE_URL=sqlite:///backend_data/backend.db
BACKEND_STORAGE_DIR=backend_data/files
# Single local workspace: no accounts or teacher review configuration.
# Private GPU service; use the same random token on both machines.
BACKEND_MODEL_URL=http://127.0.0.1:8100
BACKEND_MODEL_TOKEN=
BACKEND_MODEL_ID=Qwen/Qwen3.5-9B-Base
BACKEND_MODEL_REVISION=main
BACKEND_ADAPTER=training_output/shared-economics/adapter
# Needed for PDF OCR. Images use Vision directly with ADC.
BACKEND_GCS_BUCKET=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/credentials.json
BACKEND_WORKER_ENABLED=true
BACKEND_MAX_UPLOAD_MB=20
BACKEND_MAX_PAGES=20
